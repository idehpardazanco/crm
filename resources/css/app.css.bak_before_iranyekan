/* Dana globally */

html,
body,
#app {
    font-family: 'DanaFaNum', Tahoma, Arial, sans-serif !important;
}

button,
input,
textarea,
select,
option {
    font-family: 'DanaFaNum', Tahoma, Arial, sans-serif !important;
}

.crm-shell,
.crm-shell a,
.crm-shell button,
.crm-shell input,
.crm-shell select,
.crm-shell textarea,
.crm-shell label,
.crm-shell table,
.crm-shell th,
.crm-shell td,
.crm-shell h1,
.crm-shell h2,
.crm-shell h3,
.crm-shell h4,
.crm-shell h5,
.crm-shell h6,
.crm-shell p,
.crm-shell span {
    font-family: 'DanaFaNum', Tahoma, Arial, sans-serif;
}

.font-sans {
    font-family: 'DanaFaNum', Tahoma, Arial, sans-serif !important;
}

.vpd-wrapper,
.vpd-wrapper *,
.vpd-container,
.vpd-container *,
.vpd-content,
.vpd-content * {
    font-family: 'DanaFaNum', Tahoma, Arial, sans-serif !important;
}




/* =========================================================
   CRM GLOBAL
   ========================================================= */

:root {
    --crm-primary: #2563eb;
    --crm-primary-dark: #1d4ed8;
    --crm-sidebar: #0f274a;
    --crm-sidebar-dark: #0b1f3a;
    --crm-bg: #f4f7fb;
    --crm-border: #e2e8f0;
    --crm-text: #172033;
    --crm-muted: #64748b;
}


body {
    margin: 0;
    background: var(--crm-bg);
    color: var(--crm-text);
    font-family:
        'DanaFaNum',
        Tahoma,
        Arial,
        sans-serif;
}


/* =========================================================
   SHELL
   ========================================================= */

.crm-shell {
    min-height: 100vh;
    background:
        linear-gradient(
            180deg,
            #f8fafc 0%,
            #f3f6fb 100%
        );
    direction: rtl;
}


.crm-sidebar {
    background:
        linear-gradient(
            180deg,
            var(--crm-sidebar) 0%,
            var(--crm-sidebar-dark) 100%
        );
    box-shadow: -8px 0 35px rgba(15, 39, 74, .12);
}


.crm-main {
    min-width: 0;
}


.crm-topbar {
    background: rgba(255, 255, 255, .94);
    border-bottom: 1px solid #e8edf5;
    box-shadow: 0 3px 18px rgba(15, 23, 42, .035);
    backdrop-filter: blur(10px);
}


.crm-content {
    min-width: 0;
}


/* صفحه‌هایی که خودشان p-6 دارند */
main.crm-content > .p-6 {
    padding: 0 !important;
}


/* =========================================================
   HEADINGS
   ========================================================= */

.crm-content h1 {
    color: #111827;
    font-weight: 800 !important;
    letter-spacing: -.02em;
}


.crm-content h2,
.crm-content h3 {
    color: #1e293b;
}


/* =========================================================
   FORMS
   ========================================================= */

.crm-content input:not([type="checkbox"]):not([type="radio"]),
.crm-content select,
.crm-content textarea {
    min-height: 44px;
    border: 1px solid #d7deea !important;
    border-radius: 10px !important;
    background: #fff !important;
    color: #172033 !important;
    padding: 9px 12px !important;
    outline: none;
    box-shadow:
        0 1px 2px rgba(15, 23, 42, .02);
    transition:
        border-color .18s ease,
        box-shadow .18s ease,
        background .18s ease;
}


.crm-content textarea {
    min-height: 110px;
    resize: vertical;
}


.crm-content input:focus,
.crm-content select:focus,
.crm-content textarea:focus {
    border-color: #60a5fa !important;
    box-shadow:
        0 0 0 3px rgba(37, 99, 235, .10) !important;
}


.crm-content input::placeholder,
.crm-content textarea::placeholder {
    color: #94a3b8;
}


.crm-content select {
    color-scheme: light;
}


.crm-content select option {
    background: #fff;
    color: #172033;
}


.crm-content label {
    color: #334155;
    font-weight: 600;
}


/* =========================================================
   PRIMARY BUTTONS
   ========================================================= */

.crm-content .bg-blue-600,
.crm-content .bg-green-600 {
    border: 0 !important;
    border-radius: 10px !important;
    font-weight: 600;
    box-shadow:
        0 5px 14px rgba(37, 99, 235, .15);
    transition:
        transform .15s ease,
        box-shadow .15s ease,
        opacity .15s ease;
}


.crm-content .bg-blue-600:hover,
.crm-content .bg-green-600:hover {
    transform: translateY(-1px);
    box-shadow:
        0 8px 20px rgba(37, 99, 235, .19);
}


.crm-content a,
.crm-content button {
    transition:
        color .15s ease,
        background .15s ease,
        opacity .15s ease;
}


.crm-content .text-blue-600 {
    color: #2563eb !important;
    font-weight: 600;
}


.crm-content .text-red-600 {
    color: #dc2626 !important;
    font-weight: 600;
}


/* =========================================================
   TABLES
   ========================================================= */

.crm-content table {
    width: 100%;
    border-collapse: separate !important;
    border-spacing: 0;
    background: #fff;
    border: 1px solid #e3e9f2 !important;
    border-radius: 14px;
    overflow: hidden;
    box-shadow:
        0 5px 22px rgba(15, 23, 42, .045);
}


.crm-content table thead {
    background: #f8fafc;
}


.crm-content table th {
    color: #334155;
    font-weight: 700;
    font-size: 14px;
    white-space: nowrap;
}


.crm-content table th,
.crm-content table td {
    text-align: right;
    padding: 13px 15px !important;
    border: 0 !important;
    border-bottom:
        1px solid #edf1f6 !important;
}


.crm-content table tbody tr {
    transition: background .15s ease;
}


.crm-content table tbody tr:hover {
    background: #f8fbff;
}


.crm-content table tbody tr:last-child td {
    border-bottom: 0 !important;
}


/* =========================================================
   CARDS / PANELS
   ========================================================= */

.crm-content .grid > .border.rounded,
.crm-content .border.rounded.p-5 {
    background: #fff;
    border-color: #e2e8f0 !important;
    border-radius: 14px !important;
    box-shadow:
        0 5px 20px rgba(15, 23, 42, .04);
}


.crm-content .border.rounded {
    border-color: #e2e8f0;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

.crm-shell * {
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
}


.crm-shell ::-webkit-scrollbar {
    width: 7px;
    height: 7px;
}


.crm-shell ::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 20px;
}


/* =========================================================
   FLASH
   ========================================================= */

.crm-flash {
    border-radius: 12px;
    padding: 12px 16px;
    margin-bottom: 18px;
    font-size: 14px;
    font-weight: 600;
}


.crm-flash-success {
    background: #ecfdf5;
    color: #047857;
    border: 1px solid #a7f3d0;
}


.crm-flash-error {
    background: #fef2f2;
    color: #b91c1c;
    border: 1px solid #fecaca;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 767px) {

    .crm-content {
        padding: 18px !important;
    }

    .crm-content table {
        min-width: 720px;
    }

    .crm-content h1 {
        font-size: 21px !important;
    }
}
